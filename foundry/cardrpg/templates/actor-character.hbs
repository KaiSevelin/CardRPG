{{!--
  Character sheet: the reference surface. Live play happens on the tray, so this is what you consult
  between turns. Tabbed, because there is more here than fits a window.
--}}
<div class="cr-sheet">

  <header class="cr-sheet__header">
    <div class="cr-sheet__top">
      <input type="text" name="name" value="{{actor.name}}" placeholder="Name" class="cr-name">
      <button type="button" class="cr-tray-button" data-action="openTray"
              data-tooltip="The hand and the live state. This is what you play from.">Tray</button>
      <button type="button" class="cr-level-button {{#if pendingLevels}}cr-level-button--ready{{/if}}"
              data-action="levelUp"
              data-tooltip="The levelling graph. Readable any time; spendable when the GM grants a level.">
        {{localize "CARDRPG.Level.Pane"}}{{#if pendingLevels}} ({{pendingLevels}}){{/if}}
        {{!-- How many nodes are on your frontier right now, which is worth knowing before you
              open a graph of 169. --}}
        {{#if frontierCount}}<span class="cr-level-button__open">{{frontierCount}} open</span>{{/if}}
      </button>
    </div>
    <div class="cr-sheet__identity">
      <label>Way
        <select name="system.way">
          <option value="">&mdash;</option>
          {{selectOptions ways selected=system.way localize=true}}
        </select>
      </label>
      <label>Background
        <input type="text" name="system.background" value="{{system.background}}">
      </label>
      {{!--
        Level, title and the Ways walked are DERIVED from the owned node list
        (rules/leveling.md 9), so they are a readout and not a field. The Way dropdown above is
        still stored and is still how a playtest character is set up; that overlap is section 9's
        one remaining seam, and it closes when creation grants a Way node instead.
      --}}
      <span class="cr-standing">
        <strong>{{localize "CARDRPG.Level.Level"}} {{system.level}}</strong>
        {{#if system.title}}<span class="cr-standing__title">{{system.title}}</span>{{/if}}
        {{!--
          The Ways actually walked, which is the other half of the seam described above: the
          dropdown is a declaration and this is the truth. A character who declared Shade and
          spent every level in Mind should be able to see the disagreement.
        --}}
        {{#if waysWalked}}
          <span class="cr-standing__ways" data-tooltip="Derived from the Way nodes you own">{{waysWalked}}</span>
        {{/if}}
        {{#if isGM}}
          <span class="cr-standing__grant">
            <button type="button" data-action="grantLevel" data-by="1"
                    data-tooltip="{{localize 'CARDRPG.Level.Grant'}}">+</button>
            <button type="button" data-action="grantLevel" data-by="-1"
                    data-tooltip="{{localize 'CARDRPG.Level.Revoke'}}"
                    {{#unless pendingLevels}}disabled{{/unless}}>&minus;</button>
          </span>
        {{/if}}
      </span>
      {{#if isGM}}
        {{!--
          The levelling graph only ever ADDS: the pane takes a node and nothing anywhere took one
          back, so a mis-clicked node was permanent. Everything about a character derives from this
          list (leveling 9), which cuts both ways -- it is why there is nothing else to correct, and
          why this list has to be correctable. GM only, because it is not a choice, it is a fix.
        --}}
        <details class="cr-nodes">
          <summary>Nodes ({{ownedNodes.length}})</summary>
          <p class="cr-note">Everything else on this sheet is derived from these. Removing one
            un-does the level; it does not take back the card or slate it handed over.</p>
          <ul class="cr-nodes__list">
            {{#each ownedNodes}}
              <li>
                <button type="button" data-action="dropNode" data-node="{{this.id}}"
                        data-tooltip="Take this node back off the character.">&times;</button>
                <span class="cr-nodes__name">{{this.name}}</span>
                {{#if this.title}}<span class="cr-nodes__title">{{this.title}}</span>{{/if}}
              </li>
            {{/each}}
          </ul>
        </details>
      {{/if}}
      {{#if system.terms}}
        {{!-- What each god asks, and what the lone ones give back. A priest who cannot see their
              obedience cannot keep it, and unlike a Tactic these accumulate. --}}
        {{#each system.terms}}
          <div class="cr-obedience">
            <span class="cr-obedience__god">{{this.god}}</span>
            <span class="cr-obedience__text">{{this.obedience}}</span>
            {{#if this.gift}}<span class="cr-obedience__gift">{{this.gift}}</span>{{/if}}
          </div>
        {{/each}}
      {{/if}}
      {{#if system.tactic}}
        {{!--
          Your Tactic is derived from your deepest title and you only ever have one (way-cards 2.5),
          so it belongs on the sheet as a standing fact rather than in the feature list where it
          would look like something you could drop.
        --}}
        <span class="cr-tactic" data-tooltip="{{system.tactic.text}}">
          <strong>{{system.tactic.name}}</strong>
          <span class="cr-tactic__text">{{system.tactic.text}}</span>
        </span>
      {{/if}}
    </div>
  </header>

  <nav class="cr-tabs">
    {{#each tabs}}
      <button type="button" data-action="switchTab" data-tab="{{this.id}}"
              class="{{#if this.active}}active{{/if}}">{{this.label}}</button>
    {{/each}}
  </nav>

  <div class="cr-sheet__body">

    {{#if onVitals}}
      {{!-- Derived values are shown but never editable, and marked so it is obvious which. --}}
      <section class="cr-vitals">
        <label class="cr-stat">Health
          <span class="cr-stat__pair">
            <input type="number" name="system.health.value" value="{{system.health.value}}" min="0">
            <span class="cr-stat__sep">/</span>
            <span class="cr-stat__derived" data-tooltip="Base {{system.health.base}}{{#if system.afflicted}}, &minus;3 Afflicted{{/if}}">{{system.health.max}}</span>
          </span>
        </label>

        <label class="cr-stat">Base health
          <input type="number" name="system.health.base" value="{{system.health.base}}" min="1">
        </label>

        {{!--
          **[FIXED 2026-11-13] Stamina was on no sheet anywhere.** It is the stat that decides how
          many cards you may play in a fight (core-rules 8) and it was readable only in the combat
          HUD -- so outside a fight a player could not see the number, and *Deck floor* sitting
          there in its place was read as the stamina it is not.
        --}}
        <label class="cr-stat">Stamina
          <span class="cr-stat__pair">
            <input type="number" name="system.stamina.value" value="{{system.stamina.value}}" min="0">
            <span class="cr-stat__sep">/</span>
            <span class="cr-stat__derived" data-tooltip="How many cards you may still play this fight. Base {{system.stamina.base}}{{#if system.overloaded}}, less the Overloaded penalty{{/if}}. It comes back in full when the fight ends.">{{system.stamina.max}}</span>
          </span>
        </label>
        <label class="cr-stat">Base stamina
          <input type="number" name="system.stamina.base" value="{{system.stamina.base}}" min="1"
                 data-tooltip="Every card played costs one, whether it is a primary, a secondary or a reaction. Nothing you did not play costs any.">
        </label>

        <label class="cr-stat">Block
          <input type="number" name="system.block" value="{{system.block}}" min="0">
        </label>

        <div class="cr-stat">Armor
          <span class="cr-stat__derived" data-tooltip="From the equipped body slate">{{system.armor}}</span>
          {{!--
            The Ironclad's Signature is the only thing in the game that WANTS you over the carry
            limit, and it was computed and never shown: a player who cannot see it fire cannot
            decide to go heavy on purpose.
          --}}
          {{#if system.armorDoubled}}
            <span class="cr-stat__flag" data-tooltip="Doubled: you are carrying more than you can, and your armour likes it">&times;2</span>
          {{/if}}
        </div>

        {{!--
          The bases were stored and off the sheet, so only a macro could set them. They are not
          derived -- the derived total sits beside each one -- and a stored number nobody can edit
          is a number the GM has to reach through the console for.
        --}}
        <label class="cr-stat">Hand size
          <input type="number" name="system.handSize.base" value="{{system.handSize.base}}" min="1">
          <span class="cr-stat__derived" data-tooltip="Base plus features and nodes, to the cap of {{system.handSize.cap}}">&rarr; {{system.handSize.max}}</span>
          {{!-- A grant the cap ate is said out loud, or it is a reward that changes no number. --}}
          {{#if system.handSize.wasted}}
          <span class="cr-warn" data-tooltip="You hold grants for {{system.handSize.wasted}} more card(s) than the cap of {{system.handSize.cap}} allows, so that many are doing nothing. Hand size is the dearest stat in the game and 7 is where the priced curve flattens.">at the cap, {{system.handSize.wasted}} wasted</span>
          {{/if}}
        </label>
        <label class="cr-stat">Carry
          <input type="number" name="system.carry.base" value="{{system.carry.base}}" min="0">
          <span class="cr-stat__derived" data-tooltip="Base plus features and nodes">&rarr; {{system.carry.max}}</span>
        </label>
        <label class="cr-stat">Spell slots
          <input type="number" name="system.spellSlots.base" value="{{system.spellSlots.base}}" min="0">
          <span class="cr-stat__derived" data-tooltip="Base plus nodes, then capped by any vow">&rarr; {{system.spellSlots.max}}</span>
        </label>
        <label class="cr-stat">Deck size
          <input type="number" name="system.actionDeck.base" value="{{system.actionDeck.base}}" min="1">
          <span class="cr-stat__derived" data-tooltip="Base plus nodes">&rarr; {{system.actionDeck.max}}</span>
        </label>
        <label class="cr-stat">Deck floor
          <input type="number" name="system.actionDeck.min" value="{{system.actionDeck.min}}" min="1"
                 data-tooltip="The smallest your action deck may get. A prune is refused below this, because a prune is the one reward that can make a character illegal. It is not your stamina: stamina is how many cards you may play, and it is above.">
        </label>

        <label class="cr-stat">Rest tokens
          <span class="cr-stat__pair">
            <input type="number" name="system.rest.tokens" value="{{system.rest.tokens}}" min="0">
            <span class="cr-stat__sep">/</span>
            <input type="number" name="system.rest.max" value="{{system.rest.max}}" min="0">
          </span>
        </label>

        <label class="cr-stat">Gold
          <input type="number" name="system.cash.gold" value="{{system.cash.gold}}" min="0">
        </label>
      </section>

      {{!-- Slots govern what you can use; weight governs what you can haul. --}}
      <section class="cr-block">
        <h3>Carrying <span class="cr-tier cr-tier--{{encumbrance.tier}}">{{encumbrance.label}}</span></h3>
        <div class="cr-meter">
          <span>{{encumbrance.carried}} / {{encumbrance.max}} kg</span>
          <span class="cr-meter__bar">
            <span class="cr-meter__fill" style="width: {{encumbrance.pct}}%"></span>
          </span>
        </div>
        <p class="cr-note">100 gold weighs 1 kg, so a chest of treasure is a problem.</p>
        {{#if encumbrance.isOverloaded}}
          <p class="cr-warn">Overloaded: <strong>{{config.defaults.overloadedStamina}} stamina</strong> while this lasts &mdash; that many fewer cards you can play.</p>
        {{/if}}
        {{#if encumbrance.isImmobile}}
          <p class="cr-warn">Over double your limit &mdash; you can't pick this up. Make two trips.</p>
        {{/if}}
      </section>

      {{!-- A condition's duration ticks on its CREATOR's turn, so the creator is a real field. --}}
      <section class="cr-block">
        <h3>Conditions</h3>
        <div class="cr-add-condition">
          <select data-condition-key>
            {{#each conditionChoices}}
              <option value="{{this.key}}">{{this.label}}</option>
            {{/each}}
          </select>
          <input type="number" data-condition-duration value="1" min="0"
                 data-tooltip="Duration. Leave empty for a condition with none.">
          <select data-condition-creator data-tooltip="Whose turn it ticks down on">
            <option value="">no creator &mdash; ticks on your own turn</option>
            {{#each actorChoices}}
              <option value="{{this.id}}">{{this.name}}</option>
            {{/each}}
          </select>
          <button type="button" data-action="addCondition">Apply</button>
        </div>
        {{#if conditions}}
          <ul class="cr-conditions">
            {{#each conditions}}
              <li class="cr-condition{{#if this.derived}} cr-condition--derived{{/if}}">
                {{crIcon this.icon}}
                <span class="cr-condition__label">{{this.label}}</span>
                {{#if this.duration}}<span class="cr-condition__duration">{{this.duration}}</span>{{/if}}
                {{#if this.creator}}<span class="cr-condition__creator">&larr; {{this.creator}}</span>{{/if}}
                {{#if this.derived}}
                  <span class="cr-note">from carried weight</span>
                {{else}}
                  <button type="button" data-action="removeCondition" data-index="{{this.index}}" data-tooltip="Remove">&times;</button>
                {{/if}}
              </li>
            {{/each}}
          </ul>
        {{else}}
          <p class="cr-note">None.</p>
        {{/if}}
      </section>

      {{!--
        **What you know, on the tab that already holds what you have.** Training, know-how and
        languages lived on the Notes tab, behind biography and appearance, which is where a player
        looks for prose they wrote rather than for a fact about their character. Training is not
        prose: it is the one binary in the game that changes a number, because an untrained user
        caps a tool bonus at +1. It belongs where Gold is, on the first tab, with the rest of what
        is simply true of you.
      --}}
      <section class="cr-block">
        {{!--
          **[FIXED 2026-11-13] Three lists, edited as lists.** All three are arrays in the data
          model and always were; only the editor was a comma-separated sentence that the sheet
          joined on the way out and split on the way back. A training is a binary that changes a
          number, so "lockpicks, gaming set" being one string meant a typo or a stray comma
          silently became a different training -- and nothing could ever offer, count or check one.
        --}}
        <h3>Training</h3>
        <p class="cr-note">Structured &mdash; an untrained user caps a tool bonus at +1.</p>
        {{> "systems/cardrpg/templates/parts/entries.hbs" list=system.trainings field="trainings" hint="lockpicks"}}

        <h3>Know-how</h3>
        <p class="cr-note">A situation, not an approach. The GM reads this; nothing automates it.</p>
        {{> "systems/cardrpg/templates/parts/entries.hbs" list=system.knowHow field="knowHow" hint="forests and tracking"}}

        <h3>Languages</h3>
        {{!-- Binary the way a training is, and it arrives from two directions: a background gives
              what you grew up with, the graph gives what you studied. This field is the first. --}}
        <p class="cr-note">What you grew up with. What you studied is below, from your nodes.</p>
        {{> "systems/cardrpg/templates/parts/entries.hbs" list=system.languages field="languages" hint="Imperial"}}

        {{!--
          What the graph has added, which is NOT editable here: it is derived from the nodes you own
          (leveling 9), so correcting it means correcting the node. The field above holds what a
          background gave you and stays yours to type in; these are the ones you levelled for.
        --}}
        {{#if fromNodes.trainings.length}}
          <h3>Trained by your nodes</h3>
          <ul class="cr-learned">
            {{#each fromNodes.trainings}}<li>{{this}}</li>{{/each}}
          </ul>
        {{/if}}
        {{#if fromNodes.languages.length}}
          <h3>Languages your nodes taught you</h3>
          <ul class="cr-learned">
            {{#each fromNodes.languages}}<li>{{this}}</li>{{/each}}
          </ul>
        {{/if}}
        {{#if fromNodes.knowHow.length}}
          <h3>Know-how from your nodes</h3>
          <ul class="cr-learned">
            {{#each fromNodes.knowHow}}<li>{{this}}</li>{{/each}}
          </ul>
        {{/if}}
      </section>
    {{/if}}

    {{#if onDeck}}
      <section class="cr-block">
        <h3>Action deck</h3>
        <div class="cr-deck">
          <span>{{deck.size}} cards (limit {{deck.min}}&ndash;{{deck.max}})</span>
          <span class="cr-deck__counts">
            draw {{deck.counts.draw}} &middot; hand {{deck.counts.hand}} &middot;
            discard {{deck.counts.discard}} &middot; spent {{deck.counts.spent}}
          </span>
          <span class="cr-deck__counts">
            fate {{deck.counts.fate}}/20{{#if fateSwing}} &middot; swing {{fateSwing}}%{{/if}}
          </span>
        </div>
        {{#if deck.underMin}}<p class="cr-warn">Under the minimum of {{deck.min}} cards.</p>{{/if}}
        {{#if deck.overMax}}<p class="cr-warn">Over the maximum of {{deck.max}} cards.</p>{{/if}}
        {{#if system.exhausted}}<p class="cr-warn">Exhausted: one card per turn, and no reactions.</p>{{/if}}
        <p class="cr-note">Wounds and Taint don't count toward the limit, so being hurt never locks
          you out of adding a card.</p>
      </section>

      <section class="cr-block">
        <h3>Lingering damage</h3>
        <p>Wounds {{system.wounds}} &middot; Taint {{system.taint.total}}
          (body {{system.taint.body}}, mind {{system.taint.mind}}){{#if system.afflicted}}
          &mdash; <span class="cr-warn-inline">Afflicted</span>{{/if}}</p>
        <p class="cr-note">Afflicted at 3 or more Taint: max Health &minus;3 until you are below 3 again.</p>
      </section>

      <section class="cr-block">
        <h3>Rests</h3>
        <span class="cr-row">
          <button type="button" data-action="shortRest" {{#unless system.rest.tokens}}disabled{{/unless}}>Short rest</button>
          <button type="button" data-action="longRest">Long rest</button>
        </span>
        <p class="cr-note">Both return Spent cards. A short rest costs a token and heals 1; a long
          rest heals 5 and refills your tokens.</p>
      </section>
    {{/if}}

    {{#if onGear}}
      <section class="cr-block">
        <h3>Equipped</h3>
        {{#each equipped as |slot key|}}
          <div class="cr-slot">
            <h4>{{crIcon slot.icon}} {{slot.label}}
              <span class="cr-note">{{slot.items.length}}/{{slot.capacity}}</span>
            </h4>
            <ul class="cr-slates">
              {{#each slot.items as |slate|}}
                <li class="cr-slate-row" data-group="{{slate.system.group}}">
                  <span class="cr-slate-row__name">{{slate.name}}</span>
                  <span class="cr-note">{{slate.system.weight}} kg</span>
                  <button type="button" data-action="toggleEquipped" data-slate-id="{{slate.id}}">Unequip</button>
                  <span class="cr-menu">
                    <button type="button" class="cr-menu__dots" data-action="rowMenu"
                            data-tooltip="More" aria-label="More">&#8943;</button>
                    <span class="cr-menu__items">
                      <button type="button" data-action="editSlate" data-slate-id="{{slate.id}}">Edit</button>
                    </span>
                  </span>
                </li>
              {{else}}
                <li class="cr-note">Empty.</li>
              {{/each}}
            </ul>
          </div>
        {{/each}}
      </section>

      <section class="cr-block">
        <h3>Pack</h3>
        <ul class="cr-slates">
          {{#each pack as |slate|}}
            <li class="cr-slate-row" data-group="{{slate.system.group}}">
              <span class="cr-slate-row__name">{{slate.name}}</span>
              <span class="cr-note">{{slate.system.weight}} kg &middot; {{slate.system.value}} g</span>
              <button type="button" data-action="toggleEquipped" data-slate-id="{{slate.id}}">Equip</button>
              <span class="cr-menu">
                <button type="button" class="cr-menu__dots" data-action="rowMenu"
                        data-tooltip="More" aria-label="More">&#8943;</button>
                <span class="cr-menu__items">
                  <button type="button" data-action="editSlate" data-slate-id="{{slate.id}}">Edit</button>
                  <button type="button" class="cr-menu__danger" data-action="deleteSlate"
                          data-slate-id="{{slate.id}}">Delete</button>
                </span>
              </span>
            </li>
          {{else}}
            <li class="cr-note">Nothing in the pack.</li>
          {{/each}}
        </ul>
        <p class="cr-note">Equipping is free outside combat. Ready only costs a card half under pressure.</p>
      </section>
    {{/if}}

    {{#if onFeatures}}
      <section class="cr-block">
        <h3>Features</h3>
        <p class="cr-note">A passive feature is simply true. An active one Drains when used and comes
          back on its recharge.</p>
        <ul class="cr-slates">
          {{#each features as |entry|}}
            <li class="cr-slate-row{{#if entry.drain.drained}} cr-slate-row--drained{{/if}}" data-group="{{entry.doc.system.group}}">
              <span class="cr-slate-row__name">{{entry.doc.name}}</span>
              <span class="cr-note">{{entry.doc.system.text}}</span>
              {{#if entry.drain}}
                <span class="cr-recharge" data-tooltip="Recharges: {{entry.drain.label}}">
                  {{crIcon entry.drain.icon}}{{entry.drain.label}}
                </span>
                <button type="button" data-action="toggleDrained" data-slate-id="{{entry.doc.id}}">
                  {{#if entry.drain.drained}}Restore{{else}}Drain{{/if}}
                </button>
              {{/if}}
              <span class="cr-menu">
                <button type="button" class="cr-menu__dots" data-action="rowMenu"
                        data-tooltip="More" aria-label="More">&#8943;</button>
                <span class="cr-menu__items">
                  <button type="button" data-action="editSlate" data-slate-id="{{entry.doc.id}}">Edit</button>
                </span>
              </span>
            </li>
          {{else}}
            <li class="cr-note">No features.</li>
          {{/each}}
        </ul>
      </section>

      <section class="cr-block">
        <h3>Injuries</h3>
        <p class="cr-note">A permanent injury is a feature you did not choose. One of each category
          at most, and a ritual is what lifts it &mdash; except an obligation, which lifts for
          nobody.</p>
        <ul class="cr-slates">
          {{#each injuries as |entry|}}
            <li class="cr-slate-row" data-group="{{entry.doc.system.category}}">
              <span class="cr-slate-row__name">{{crIcon entry.icon}}{{entry.doc.name}}</span>
              <span class="cr-note">{{entry.doc.system.text}}</span>
              <span class="cr-note">{{entry.category}} &mdash; {{entry.lasts}}. {{entry.lift}}.</span>
              {{#if entry.doc.system.cause}}
                <span class="cr-note">{{entry.doc.system.cause}}</span>
              {{/if}}
              <span class="cr-menu">
                <button type="button" class="cr-menu__dots" data-action="rowMenu"
                        data-tooltip="More" aria-label="More">&#8943;</button>
                <span class="cr-menu__items">
                  <button type="button" data-action="editSlate" data-slate-id="{{entry.doc.id}}">Edit</button>
                </span>
              </span>
            </li>
          {{else}}
            <li class="cr-note">No injuries.</li>
          {{/each}}
        </ul>
        {{#if injuryRoom}}
          <p class="cr-note">Still open: {{injuryRoom}}.</p>
        {{/if}}
      </section>
    {{/if}}

    {{#if onNotes}}

      <section class="cr-block">
        <h3>Biography</h3>
        <textarea name="system.biography" rows="5">{{system.biography}}</textarea>
        <h3>Appearance</h3>
        <textarea name="system.appearance" rows="4">{{system.appearance}}</textarea>
      </section>

      {{#if isGM}}
        <section class="cr-block cr-block--gm">
          <h3>GM notes</h3>
          <p class="cr-note">Hidden from the player: what NPCs know, hidden Taint sources, anything planted.</p>
          <textarea name="system.gmNotes" rows="4">{{system.gmNotes}}</textarea>
        </section>
      {{/if}}
    {{/if}}

  </div>
</div>
