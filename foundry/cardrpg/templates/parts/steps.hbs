{{!--
  A list of steps, editable: a card's half, an NPC's sequence, a Wild Magic surge.

  The order is the content -- "Move 3, then Strike" plays nothing like "Strike, then Move 3" -- so
  the index is shown and a step is removed by index rather than by matching on what it holds.

  `list` is the schema key, which is also the form path: `system.primary.0.verb` is how Foundry
  addresses the first step's verb, so the partial builds that path and nothing has to translate.
--}}
<section class="cr-block cr-steps">
  <h3>{{label}}</h3>
  {{#each steps}}
    <div class="cr-steps__item">
      <div class="cr-steps__head">
        <span class="cr-steps__n">{{@index}}</span>
        <button type="button" class="cr-steps__drop" data-action="removeStep"
                data-list="{{../list}}" data-index="{{@index}}"
                data-tooltip="Take this step out. The order is the content, so the rest close up.">&times;</button>
      </div>
      {{> "systems/cardrpg/templates/parts/step.hbs"
          step=this path=(concat "system." ../list "." @index) config=../config}}
    </div>
  {{/each}}
  {{#unless steps.length}}
    <p class="cr-note">No steps. A half with none is a half that does nothing &mdash; which for a
      reaction card is exactly right, since Brace is the floor under a card that prints nothing.</p>
  {{/unless}}
  <button type="button" data-action="addStep" data-list="{{list}}">Add a step</button>
</section>
