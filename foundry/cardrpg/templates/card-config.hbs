{{!--
  One config sheet for every card subtype. Faces render from icon keys, never from a stored image,
  because a condition can switch off any half showing a given icon.

  Step editing is intentionally not here: cards are authored in bulk by the content routine and in
  compendiums, so this shows the face and exposes only the fields worth hand-editing.
--}}
<div class="cr-sheet">

  <header class="cr-sheet__header">
    <input type="text" name="name" value="{{card.name}}" placeholder="Name" class="cr-name">
    <span class="cr-note">{{localize (concat "TYPES.Card." type)}}</span>
  </header>

  <div class="cr-sheet__body">


  {{!-- Face preview --}}
  <section class="cr-block">
    <h3>Face</h3>

    {{#if isAction}}
      <div class="cr-card" {{#if art}}style="--cr-art: url('{{art}}')"{{/if}}>
        <div class="cr-card__name">{{card.name}}</div>
        <div class="cr-half cr-half--primary">
          <span class="cr-half__marker">{{crIcon config.halfIcons.primary}}</span>
          <span>{{#each face.primary}}{{crIcon this.icon}}{{this.num}} {{this.text}}{{/each}}</span>
        </div>
        <div class="cr-half cr-half--secondary">
          <span class="cr-half__marker">{{crIcon config.halfIcons.secondary}}</span>
          <span>{{#each face.secondary}}{{crIcon this.icon}}{{this.num}} {{this.text}}{{/each}}</span>
        </div>
        <div class="cr-half cr-half--reaction">
          <span class="cr-half__marker">{{crIcon config.halfIcons.reaction}}</span>
          <span>{{#if face.reaction}}{{face.reaction}}{{else}}&mdash;{{/if}}</span>
        </div>
      </div>
      <p class="cr-note">Any card without a printed reaction can still be discarded for
        <strong>Brace</strong>, which is never blocked &mdash; so no card is ever completely dead.</p>
    {{/if}}

    {{#if isFate}}
      <div class="cr-card cr-card--fate{{#if system.temporary}} cr-card--temporary{{/if}}">
        {{face.label}}
      </div>
      {{#if system.temporary}}
        <p class="cr-note">Temporary: shuffled in by Blessed or Cursed, and removed when drawn. The
          corner mark is what makes that possible.</p>
      {{/if}}
    {{/if}}

    {{#if isNpcCard}}
      <div class="cr-card{{#if isSole}} cr-card--sole{{/if}}" {{#if art}}style="--cr-art: url('{{art}}')"{{/if}}>
        <div class="cr-card__name">{{card.name}}</div>
        {{#if isSole}}
          <div class="cr-note" data-tooltip="Only this creature can draw it. Four cards in five in an NPC deck are shared.">This creature's own</div>
        {{/if}}
        <ol class="cr-sequence">
          {{#each face.sequence}}
            <li>{{crIcon this.icon}}{{this.num}} {{this.text}}</li>
          {{/each}}
        </ol>
      </div>
      <p class="cr-note">The order is the content: "Move 3, then Strike" plays nothing like
        "Strike, then Move 2". The back shows only the type, which is what Foresee reveals.</p>
    {{/if}}

    {{#if isHarm}}
      <div class="cr-card cr-card--harm">
        <div class="cr-card__name">{{card.name}}</div>
        <div class="cr-half">
          {{!-- The card's own line, from the intruder table. Never an if/else over the kinds. --}}
          <span>{{harmLine}}</span>
        </div>
      </div>
      <p class="cr-note">No bands, because it can't be played &mdash; that absence is the signal.
        It takes the standard card back, so it's indistinguishable in the draw pile.</p>
    {{/if}}
  </section>

  {{!-- Editable fields, per subtype --}}
  {{#if isAction}}
    <section class="cr-block">
      <h3>Reaction</h3>
      <select name="system.reaction">
        <option value="">&mdash; none (Brace only)</option>
        {{selectOptions reactions selected=system.reaction labelAttr="label" localize=true}}
      </select>
      {{!--
        How much, for a reaction that takes a number. Only Sidestep does -- it is `valued` in the
        config the way a condition that carries an intensity is -- and *Roll With It* is the one
        card in the documents that needs it. A number beside the key rather than a schema around
        both, which is the house idiom; the validator refuses a number on a reaction that does not
        take one.
      --}}
      <label class="cr-stat">Reaction value
        <input type="number" name="system.reactionParam" value="{{system.reactionParam}}" min="1"
               placeholder="&mdash;"
               data-tooltip="Only a valued reaction takes one: Sidestep 2. Leave it empty otherwise.">
      </label>
    </section>

    <section class="cr-block">
      <h3>What each half costs</h3>
      {{!--
        The price of playing a half, paid before it resolves. Both sit on the HALF and not on the
        card, because every other thing a card does sits on the half -- a card can be a spell on
        one side and a step sideways on the other, and burning it for the step sideways should be
        the player's mistake to make rather than the schema's.
      --}}
      <p class="cr-note">Spent retires the card for the fight and it comes back on a rest. Strain
        discards that many <em>other</em> cards from your hand, so it costs the round rather than
        the fight.</p>
      <div class="cr-costs">
        {{#each halves}}
          <div class="cr-costs__half">
            <span class="cr-costs__label">{{this.label}}</span>
            <label>
              <input type="checkbox" name="system.costs.{{this.key}}.spent"
                     {{#if this.spent}}checked{{/if}}> Spent
            </label>
            <label>Strain
              <input type="number" name="system.costs.{{this.key}}.strain" value="{{this.strain}}"
                     min="0">
            </label>
          </div>
        {{/each}}
      </div>
    </section>

    <section class="cr-block">
      <h3>Where it came from</h3>
      <p class="cr-note">Which Way's list this belongs to. Reserved when it was written and
        unfilled since, so it is a plain text pair rather than two dropdowns over vocabularies the
        content does not use yet.</p>
      <label class="cr-stat">Way
        <input type="text" name="system.way" value="{{system.way}}" placeholder="shade">
      </label>
      <label class="cr-stat">Tree
        <input type="text" name="system.tree" value="{{system.tree}}" placeholder="thief">
      </label>
    </section>
  {{/if}}

  {{#if isFate}}
    <section class="cr-vitals">
      <label class="cr-stat">Value
        <input type="number" name="system.value" value="{{system.value}}">
      </label>
      <label class="cr-stat">Special
        <select name="system.special">
          <option value="" {{#if (crEq system.special "")}}selected{{/if}}>&mdash; numeric</option>
          <option value="miss" {{#if (crEq system.special "miss")}}selected{{/if}}>Miss</option>
          <option value="crit" {{#if (crEq system.special "crit")}}selected{{/if}}>Critical</option>
        </select>
      </label>
      <label class="cr-stat cr-stat--check">
        <input type="checkbox" name="system.temporary" {{#if system.temporary}}checked{{/if}}> Temporary
      </label>
    </section>
    <p class="cr-note">Miss and Critical both reshuffle the deck, which is why the fate counter is a
      live risk readout: with k cards left the chance of a swing is 2/k.</p>
  {{/if}}

  {{#if isNpcCard}}
    <section class="cr-block">
      <h3>Creature type</h3>
      <input type="text" name="system.kind" value="{{system.kind}}" placeholder="goblin">
      <p class="cr-note">The type owns this deck. Every NPC of it acts on one card per round.</p>
    </section>
  {{/if}}

  {{#if isTaint}}
    <section class="cr-vitals">
      <label class="cr-stat">Flavour
        <select name="system.flavour">
          <option value="body" {{#if (crEq system.flavour "body")}}selected{{/if}}>Body &mdash; action deck</option>
          <option value="mind" {{#if (crEq system.flavour "mind")}}selected{{/if}}>Mind &mdash; skill deck</option>
        </select>
      </label>
    </section>
  {{/if}}

  {{!-- Every intruder records what put it there, so the source field is the category's, not one
        kind's. Taint keeps its own section above for the flavour, which only it has. --}}
  {{#if isHarm}}
    <section class="cr-block">
      <label>Source <input type="text" name="system.source" value="{{system.source}}"></label>
    </section>
  {{/if}}

  {{#if isSkill}}
    {{!--
      A skill card: one approach and a value. `wild` is the Inspiration card -- any approach, worth
      1 -- and it is a flag rather than an `any` approach because `any` already means something
      else in the approach list (a tool that helps with everything).
    --}}
    <section class="cr-vitals">
      <label class="cr-stat">Approach
        <select name="system.approach">
          <option value="">&mdash;</option>
          {{selectOptions approaches selected=system.approach labelAttr="label" localize=true}}
        </select>
      </label>
      <label class="cr-stat">Value
        <input type="number" name="system.value" value="{{system.value}}" min="0" max="3">
      </label>
      <label class="cr-stat">
        <input type="checkbox" name="system.wild" {{#if system.wild}}checked{{/if}}>
        Inspiration &mdash; any approach
      </label>
    </section>
    <section class="cr-block">
      <h3>Edge</h3>
      <p class="cr-note">What playing it does whether or not the check succeeds. Prose: the table
        resolves it, not the engine.</p>
      <input type="text" name="system.edge" value="{{system.edge}}"
             placeholder="Ask the GM one yes-or-no question about the scene.">
    </section>
  {{/if}}

  {{#if isWild}}
    <section class="cr-vitals">
      <label class="cr-stat">Turn
        <select name="system.turn">
          <option value="good" {{#if (crEq system.turn "good")}}selected{{/if}}>Good</option>
          <option value="bad" {{#if (crEq system.turn "bad")}}selected{{/if}}>Bad</option>
          <option value="both" {{#if (crEq system.turn "both")}}selected{{/if}}>Both</option>
        </select>
      </label>
    </section>
    <section class="cr-block">
      <h3>Text</h3>
      <p class="cr-note">Declared rather than inferred from the steps: what a surge is worth
        depends on where everyone is standing, and no reading of its step can tell.</p>
      <input type="text" name="system.text" value="{{system.text}}">
    </section>
    {{> "systems/cardrpg/templates/parts/steps.hbs" steps=steps.steps list="steps" label="Steps" config=config}}
  {{/if}}

  {{#if isAction}}
    {{!--
      What the card DOES, editable. It was read-only for as long as this sheet has existed, which
      meant a GM could retune a card's reaction and not what it did -- the half the content is
      actually made of.
    --}}
    {{> "systems/cardrpg/templates/parts/steps.hbs" steps=steps.primary list="primary" label="Primary" config=config}}
    {{> "systems/cardrpg/templates/parts/steps.hbs" steps=steps.secondary list="secondary" label="Secondary" config=config}}
  {{/if}}

  {{#if isNpcCard}}
    {{!-- Ordered and numbered: "Move 3, then Strike" plays nothing like the reverse. --}}
    {{> "systems/cardrpg/templates/parts/steps.hbs" steps=steps.sequence list="sequence" label="Sequence" config=config}}
  {{/if}}
  </div>

</div>
