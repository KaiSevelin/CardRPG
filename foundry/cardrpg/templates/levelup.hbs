{{!--
  The level-up pane. The graph is the interface, because a level-up is a direction rather than a
  prize (rules/leveling.md 3). The canvas is mounted by levelup.mjs and is deliberately NOT
  re-rendered when a node is marked -- the detail panel is written in place, so a player comparing
  two nodes keeps their pan and zoom.
--}}
<div class="cr-levelup__frame">

  <header class="cr-levelup__bar">
    <span class="cr-levelup__who">
      <strong>{{title}}</strong>
      <span class="cr-levelup__level">{{localize "CARDRPG.Level.Level"}} {{level}}</span>
    </span>

    {{!--
      **No "levels to spend" counter.** It sat here reading *No level to spend* until a GM pressed
      the + on the character sheet, and leveling 2 refuses tracking in so many words -- so both the
      counter and the buttons are retired. The milestone is a sentence at the table; this window is
      for choosing the node, which is the part that needs a map.
    --}}

    <label class="cr-levelup__layout">
      {{localize "CARDRPG.Level.LayoutLabel"}}
      <select name="layout">
        {{#each layouts}}
          <option value="{{this.key}}" {{#if this.selected}}selected{{/if}}>{{this.label}}</option>
        {{/each}}
      </select>
    </label>

    <button type="button" data-action="refit" data-tooltip="{{localize 'CARDRPG.Level.Refit'}}">
      {{localize "CARDRPG.Level.RefitShort"}}
    </button>

    {{#if editing}}
      {{!--
        Authoring, and the pane says so. The graph is the one thing here that is not about this
        character: changing a node changes everybody who owns it, with no event and no log line,
        which is why this is a world setting rather than a GM permission.
      --}}
      <span class="cr-authoring" data-tooltip="This world has graph editing on. Everything about a character derives from the nodes they own, so a change here reaches every one of them.">
        <strong>Authoring</strong>
        <button type="button" data-action="editNode"
                data-tooltip="Edit the node you last tapped. The whole node is the form: a node IS its fields.">Edit node</button>
        <button type="button" data-action="addNode"
                data-tooltip="A new node. It names what it follows; nothing names its successors.">Add</button>
        <button type="button" data-action="dropGraphNode"
                data-tooltip="Remove the node you last tapped. Refused while any character owns it.">Remove</button>
      </span>
    {{/if}}
  </header>

  <div class="cr-levelup__body">
    {{!-- Cytoscape mounts here. It needs a sized box of its own, so nothing else goes in it. --}}
    <div class="cr-graph"></div>

    <aside class="cr-levelup__side">
      {{!--
        Two arrows and a place in the list. The legend already counts the available nodes; it does
        not help you FIND them, and on a graph of 169 that does not fit the window the four that
        matter are mostly off the edge of it. Stepping marks one, writes the panel and centres the
        canvas on it, so the map follows the reading.
      --}}
      <nav class="cr-levelup__choices">
        <button type="button" data-action="stepChoice" data-dir="-1"
                data-tooltip="{{localize 'CARDRPG.Level.PrevChoice'}}"
                aria-label="{{localize 'CARDRPG.Level.PrevChoice'}}">&#8249;</button>
        <span class="cr-levelup__choice-label">
          {{localize "CARDRPG.Level.ChoiceOf"}}
          <strong class="cr-levelup__choice-at"></strong>
        </span>
        <button type="button" data-action="stepChoice" data-dir="1"
                data-tooltip="{{localize 'CARDRPG.Level.NextChoice'}}"
                aria-label="{{localize 'CARDRPG.Level.NextChoice'}}">&#8250;</button>
      </nav>

      <div class="cr-levelup__detail"></div>

      <footer class="cr-levelup__actions">
        <button type="button" data-action="accept" class="cr-levelup__accept" disabled>
          {{localize "CARDRPG.Level.Accept"}}
        </button>
        <button type="button" data-action="cancelPick">
          {{localize "CARDRPG.Level.Cancel"}}
        </button>
      </footer>

      <ul class="cr-levelup__legend">
        <li><span class="cr-swatch cr-swatch--owned"></span>{{localize "CARDRPG.Level.State.Owned"}} ({{counts.owned}})</li>
        <li><span class="cr-swatch cr-swatch--available"></span>{{localize "CARDRPG.Level.State.Available"}} ({{counts.available}})</li>
        <li><span class="cr-swatch cr-swatch--later"></span>{{localize "CARDRPG.Level.State.Later"}}</li>
        <li><span class="cr-swatch cr-swatch--closed"></span>{{localize "CARDRPG.Level.State.Closed"}} ({{counts.closed}})</li>
        <li><span class="cr-swatch cr-swatch--cross"></span>{{localize "CARDRPG.Level.State.Cross"}}</li>
      </ul>
    </aside>
  </div>
</div>
