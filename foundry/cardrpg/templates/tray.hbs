{{!--
  The HUD: a layer over the canvas that ignores clicks, with decks anchored to the screen edges.

  Far left, right of the scene controls: Items, Features, Conditions stacked from the top, with
  the Action deck in the bottom-left corner.

  Down the right, clear of the sidebar buttons, the whole turn in four rows read top to bottom:
  the two play stacks with the Play button that resolves them, then Fate, then Discard, then the
  character panel.

  Every deck shows as a back with a count. Clicking one spreads it as a vertical hand; clicking it
  again closes it. Item cards can be turned over, because a slate's back is where value, weight and
  type live (card-layout.md, the four information tiers).
--}}
<div class="cr-hud-layer">

  {{!-- Status bar, along the bottom above the hand --}}
  {{!-- LEFT COLUMN: Items, Features, Conditions from the top --}}
  <section class="cr-hud__decks cr-hud__decks--left">
    {{#each leftDecks}}
      {{!-- A shut pile is a face-down deck and wears that deck's back; an open one is showing its
            cards, so it keeps the hatch and loads no texture. --}}
      <button type="button"
            class="cr-pile{{#if this.open}} cr-pile--open{{/if}}{{#if this.art}} cr-pile--faced{{/if}}"
            {{#if this.art}}style="--cr-art: url('{{this.art}}')"{{/if}}
            data-action="openPile" data-pile="{{this.id}}" data-tooltip="{{this.tip}}">
      <span class="cr-pile__count">{{this.count}}</span>
      <span class="cr-pile__label">{{this.label}}</span>
      </button>
    {{/each}}
  </section>

  {{!-- BOTTOM-LEFT CORNER: the action deck --}}
  <section class="cr-hud__decks cr-hud__decks--action">
    <button type="button"
          class="cr-pile cr-pile--action{{#if actionDeck.spent}} cr-pile--spent{{/if}}"
          data-action="dealHand" data-tooltip="{{actionDeck.tip}}">
      <span class="cr-pile__count">{{actionDeck.count}}</span>
      <span class="cr-pile__label">{{actionDeck.label}}</span>
      <span class="cr-pile__state">{{actionDeck.state}}</span>
    </button>
  </section>

  {{!--
    The play area, over the canvas above the hand: two stacks of overlapping cards, primary on the
    left. A stack is one action and everything modifying it, so where a card sits is what it is
    doing. Only the front card reads in full; the carousel turns the stack without unmaking it.
  --}}
  <section class="cr-hud__play">
    {{!--
      Row 1: who is playing, and the piles the turn draws on. Fate and the two discards are LINKS
      here, not deck backs on the table: a deck back is a big object that says "draw me", and none
      of these is drawn from by hand. It also keeps the column short enough that Foundry's own
      toasts have somewhere to land.
    --}}
    <div class="cr-options">
      <div class="cr-options__name">{{actor.name}}</div>
      <div class="cr-options__vitals">
        <span data-tooltip="Health">&#9829; {{system.health.value}}/{{system.health.max}}</span>
        <span data-tooltip="Block: subtracted from incoming damage, after armor. From a Defend. {{#if system.blockPersists}}Played as a primary, so it holds against every attack until your next turn.{{else}}Gone after the next attack, unless it came from a Defend primary.{{/if}}">&#9094; {{system.block}}{{#if system.blockPersists}}&infin;{{/if}}</span>
        <span data-tooltip="Armor: subtracted from incoming damage before Block. Always on.">&#9636; {{system.armor}}</span>
        {{#if system.wounds}}<span data-tooltip="Wounds">&#10006; {{system.wounds}}</span>{{/if}}
        {{#if system.taint.total}}<span data-tooltip="Taint">&#9763; {{system.taint.total}}</span>{{/if}}
        {{!-- The piles ride on the same row as the vitals: both are counters, and the column has
              no height to spare. --}}
        <span class="cr-options__piles">
          {{#each pileLinks}}
            <button type="button" class="cr-options__pile{{#if this.open}} cr-options__pile--open{{/if}}"
                    data-action="openPile" data-pile="{{this.id}}" data-tooltip="{{this.tip}}">
              {{crIcon this.icon}}<span class="cr-options__count">{{this.count}}</span>
            </button>
          {{/each}}
        </span>
      </div>
      {{#if exhausted}}<div class="cr-tray__flag" data-tooltip="One card per turn, and no reactions">Exhausted</div>{{/if}}
      {{#if dazed}}<div class="cr-tray__flag" data-tooltip="No secondary this turn">Dazed</div>{{/if}}
      {{#if stunned}}<div class="cr-tray__flag" data-tooltip="No reactions">Stunned</div>{{/if}}
      {{#if reserved}}<div class="cr-tray__flag" data-tooltip="Turned sideways and held back, so they will not react. {{upright}} card(s) still able to.">Held {{reserved}}</div>{{/if}}
      {{#if encumbered}}<div class="cr-tray__flag">{{encumbered}}</div>{{/if}}
      {{#if staged}}
      <div class="cr-options__staged">
      {{#each staged}}<span class="cr-chip cr-chip--staged">{{this.order}}. {{this.name}}</span>{{/each}}
      </div>
      {{/if}}
      {{#if targets}}
      <div class="cr-note" data-tooltip="Fate is drawn once per action, not per target">&#9678; {{targets}}</div>
      {{/if}}
      <div class="cr-options__buttons">
        {{!-- Play lives under the stacks it resolves. This is the undo for a mis-clicked half. --}}
        <button type="button" data-action="clear" {{#unless canClear}}disabled{{/unless}}
                data-tooltip="Empty the play area: action cards back to hand, items and features back to their decks.">Clear</button>
        <button type="button" data-action="breathe" {{#unless canBreathe}}disabled{{/unless}}
                data-tooltip="{{#if canBreathe}}Your whole turn, for {{breathRecovery}} cards out of the discard at random — exactly enough to not be Exhausted next turn.{{else}}Needs {{breathRecovery}} cards in the discard. It recovers {{breathRecovery}}, all or nothing.{{/if}}">Breath</button>
        {{#if inCombat}}
          <button type="button" data-action="endTurn"
                  data-tooltip="{{#if myTurn}}Your turn{{else}}{{turnOwner}}'s turn{{/if}}">End turn</button>
        {{/if}}
      </div>
    </div>

    <div class="cr-play__stacks">
    {{#each playArea}}
      <div class="cr-stack" data-half="{{this.half}}">
      <div class="cr-stack__head">
        <span class="cr-stack__label">{{this.label}}{{#if this.carousel}} ({{this.count}}){{/if}}</span>
        {{#if this.carousel}}
          <span class="cr-stack__nav">
            <button type="button" data-action="shiftStack" data-half="{{this.half}}" data-dir="-1"
                    data-tooltip="Turn the stack back">&#8249;</button>
            <button type="button" data-action="shiftStack" data-half="{{this.half}}" data-dir="1"
                    data-tooltip="Bring the next card to the front">&#8250;</button>
          </span>
        {{/if}}
      </div>

      <div class="cr-stack__cards" style="--cr-count: {{this.span}}">
        {{#each this.cards}}
          {{!-- The card body takes it out of the stack; its name turns the stack to it instead,
                so a card behind can be read without being disturbed. --}}
          {{!-- ONE style attribute. These were two, and a duplicate attribute is not merged by a
                browser -- the first wins and the rest are dropped -- so every stacked card that
                HAD art silently lost its --cr-depth and stacked at zero offset. --}}
          {{!-- A fixed card is a condition: it has no control at all, because it is not a choice.
                Dropping `cr-card--takeable` and the unstack action is what says so -- a
                tooltip saying "you cannot remove this" beside a button that removes it would be
                the sheet arguing with itself. --}}
          <div class="cr-card cr-card--spread cr-card--stacked{{#unless this.fixed}} cr-card--takeable{{/unless}}{{#if this.condition}} cr-card--condition{{/if}}{{#if this.assisted}} cr-card--assisted{{/if}}{{#if this.action}} cr-card--base{{/if}}{{#if this.disabled}} cr-card--disabled{{/if}}{{#if this.flipped}} cr-card--back{{/if}}"
               style="--cr-depth: {{@index}}{{#if this.art}}; --cr-art: url('{{this.art}}'){{/if}}"
               data-group="{{this.group}}" data-tooltip="{{this.tip}}"
               {{#unless this.fixed}}role="button" tabindex="0" data-action="unstack" data-half="{{../half}}"{{/unless}}
               {{#if this.slate}}data-slate-id="{{this.id}}"{{/if}}>
            <div class="cr-card__name">
              {{#if this.icon}}{{crIcon this.icon}}{{/if}}
              <button type="button" class="cr-card__title" data-action="frontCard"
                      data-half="{{../half}}" data-slot="{{this.slot}}"
                      data-tooltip="Bring it to the front">{{this.name}}</button>
              {{#if this.moveTo}}
                <button type="button" class="cr-card__half" data-action="moveHalf"
                        data-slate-id="{{this.id}}"
                        data-tooltip="Move it to the {{this.moveTo}} stack">{{this.moveArrow}}</button>
              {{/if}}
              {{!-- Only what the assist offered. A spent feature has no cross: it is a record of
                    what was used, and un-spending it is not what a cross should mean. --}}
              {{#if this.waveId}}
                <button type="button" class="cr-card__wave" data-action="wave"
                        data-wave-id="{{this.waveId}}"
                        data-tooltip="Put here for you. Click to leave it out of this action.">&#10005;</button>
              {{/if}}
              {{#if this.flippable}}
                <button type="button" class="cr-card__flip" data-action="flipCard" data-card-id="{{this.id}}"
                        data-tooltip="Turn it over for value, weight and type">&#8634;</button>
              {{/if}}
            </div>

            {{#if this.flipped}}
              <div class="cr-card__back">
                {{#if this.blurb}}<p class="cr-note">{{this.blurb}}</p>{{/if}}
                <dl class="cr-card__facts">
                  {{#each this.facts}}<dt>{{this.label}}</dt><dd>{{this.value}}</dd>{{/each}}
                </dl>
              </div>
            {{else}}
              <div class="cr-card__front">
                {{#each this.lines}}<div class="cr-card__line">{{this}}</div>{{/each}}
                {{#if this.costs}}
                  <div class="cr-card__costs">
                    {{#each this.costs}}
                      <span class="cr-cost" data-tooltip="{{this.tip}}">
                        {{crIcon this.icon}}{{#if this.value}}<span class="cr-cost__n">{{this.value}}</span>{{/if}}
                      </span>
                    {{/each}}
                  </div>
                {{/if}}
                {{#if this.note}}<p class="cr-note">{{this.note}}</p>{{/if}}
              </div>
            {{/if}}
          </div>
        {{else}}
          <div class="cr-stack__empty">Nothing played here</div>
        {{/each}}
      </div>
      </div>
    {{/each}}
    </div>

    {{!-- Directly under the stacks: the button that resolves them both. --}}
    <button type="button" class="cr-play" data-action="play" {{#unless canPlay}}disabled{{/unless}}
          data-tooltip="{{#if canPlay}}Resolve both stacks, in the order you staged them.{{else}}{{playHint}}{{/if}}">
      Play
    </button>
  </section>

  {{!-- The dealt hand: cards laid on the scene, not inside a tray --}}
  {{#if cards}}
    <section class="cr-hud__hand">
      {{#each cards as |card|}}
        {{!-- `--cr-art` is the only thing art needs: the rim is the border and the art is the
              background inside it, so a card with no picture needs no different markup. --}}
        <div class="cr-card{{#if card.harm}} cr-card--harm{{/if}}{{#if card.sole}} cr-card--sole{{/if}}{{#if card.reaction.reserved}} cr-card--reserved{{/if}}"
             {{#if card.art}}style="--cr-art: url('{{card.art}}')"{{/if}}>
          <div class="cr-card__name">{{card.name}}</div>
          {{#if card.harm}}
            <div class="cr-half"><span class="cr-note">Can't be played, not even for Brace.</span></div>
          {{else}}
            {{#each card.halves as |half|}}
              <div class="cr-half cr-half--{{half.name}}{{#if half.blocked}} cr-half--blocked{{/if}}{{#if half.staged}} cr-half--staged{{/if}}">
                <span class="cr-half__marker">{{crIcon half.icon}}</span>
                {{#if half.blocked}}
                  <span data-tooltip="{{half.tip}}">{{half.text}}</span>
                {{else}}
                  <button type="button" class="cr-half__play"
                          data-action="stage" data-card-id="{{card.id}}" data-half="{{half.name}}">{{half.text}}</button>
                {{/if}}
                {{#each half.costs}}
                  {{!-- What the half costs, printed with the half it belongs to. --}}
                  <span class="cr-cost" data-tooltip="{{this.tip}}">
                    {{crIcon this.icon}}{{#if this.value}}<span class="cr-cost__n">{{this.value}}</span>{{/if}}
                  </span>
                {{/each}}
              </div>
            {{/each}}
            {{!--
              The reaction row, which is also the only switch on a card in hand. Reactions fire by
              themselves (core-rules 3); what the player decides, in advance, is whether this card
              is available to fire at all.
            --}}
            <div class="cr-half cr-half--reaction{{#if card.reaction.blocked}} cr-half--blocked{{/if}}">
              <span class="cr-half__marker">{{crIcon ../config.halfIcons.reaction}}</span>
              {{#if card.reaction.blocked}}
                <span data-tooltip="{{card.reaction.tip}}">{{card.reaction.label}}</span>
              {{else}}
                <button type="button" class="cr-half__play" data-action="reserve"
                        data-card-id="{{card.id}}" data-tooltip="{{card.reaction.tip}}">
                  {{card.reaction.label}}{{#if card.reaction.reserved}} — held{{/if}}
                </button>
              {{/if}}
            </div>
          {{/if}}
        </div>
      {{/each}}
    </section>
  {{/if}}

  {{!--
    A deck holds only what is OUT of play; what is in play is in a stack in the play area. Clicking
    a card here puts it into play, on the primary stack if it has a half to choose. A passive
    feature can never be clicked: it is simply true.
  --}}
  {{#if scene}}
    {{!--
      The scene tray (hud-spec 5): shown whenever no Combat is active. The same window in a
      different mode rather than a second application, because the fate deck spans both modes and
      a second window would have to draw it twice.
    --}}
    <section class="cr-scene" data-group-label="Scene">
      {{!--
        The obstacle, which is the GM's half of a check (skill-rules 2, step 1). It is a banner and
        not a field in the player's dialog, because it is a state of the table rather than a thing
        each player decides: one call, in front of everybody, until the GM withdraws it.
      --}}
      {{#if scene.call}}
        <div class="cr-call" data-tooltip="The GM has called for a check. Play a card that fits.">
          <span class="cr-call__dc">{{scene.call.label}}</span>
          {{#if scene.call.note}}<span class="cr-call__note">{{scene.call.note}}</span>{{/if}}
          {{#if scene.isGM}}
            <button type="button" data-action="clearCall" class="cr-call__clear"
                    data-tooltip="Withdraw the call.">&times;</button>
          {{/if}}
        </div>
      {{else if scene.isGM}}
        <button type="button" data-action="callCheck" class="cr-call__ask"
                data-tooltip="Name the obstacle: how hard, which approach, and whether the plan earns advantage.">Call for a check</button>
      {{/if}}

      {{!--
        The two tracks of a challenge (skill-rules 3), which appear only while one is running.
        Both are printed even before either moves: how much can go wrong before this turns ugly is
        the number a player is deciding against, and a bar at zero still says what the limit is.
      --}}
      {{#if scene.challenge}}
        <div class="cr-track{{#if scene.challenge.won}} cr-track--won{{/if}}{{#if scene.challenge.lost}} cr-track--lost{{/if}}">
          {{#if scene.challenge.note}}<span class="cr-track__note">{{scene.challenge.note}}</span>{{/if}}
          <span class="cr-track__bar" data-tooltip="Progress: how much you still need to achieve.">
            <span class="cr-track__label">Progress {{scene.challenge.progress}}/{{scene.challenge.progressMax}}</span>
            <span class="cr-track__fill cr-track__fill--progress" style="width: {{scene.challenge.progressPct}}"></span>
          </span>
          <span class="cr-track__bar" data-tooltip="Pressure: how much can go wrong before this turns ugly.">
            <span class="cr-track__label">Pressure {{scene.challenge.pressure}}/{{scene.challenge.pressureMax}}</span>
            <span class="cr-track__fill cr-track__fill--pressure" style="width: {{scene.challenge.pressurePct}}"></span>
          </span>
          <button type="button" data-action="breatheScene"
                  data-tooltip="Catch Breath: Pressure +1, your discard comes back, one card is set aside as Spent, and you draw up to hand size.">Catch Breath</button>
          {{#if scene.isGM}}
            <button type="button" data-action="endChallenge" class="cr-call__clear"
                    data-tooltip="End the challenge.">&times;</button>
          {{/if}}
        </div>
      {{/if}}

      {{#if scene.passives_gm}}
        {{!--
          What the party notices, for the GM. Collapsed to one line by default, because the question
          is usually only "does anyone notice" and the answer is the best score and a name. Folded
          open it says who else could be asked.

          Not a secret-roll panel, and deliberately not: a passive score is static (hud-spec 5),
          which is what makes it safe to read in the open. Uncertainty is what a check is for.
        --}}
        <div class="cr-passives{{#if scene.passives_gm.open}} cr-passives--open{{/if}}">
          <button type="button" data-action="togglePassives" class="cr-passives__fold"
                  aria-expanded="{{#if scene.passives_gm.open}}true{{else}}false{{/if}}"
                  data-tooltip="What the party notices without drawing anything. The best card of that approach in the whole deck, plus 2 — it counts the discard and never changes during play.">
            {{#if scene.passives_gm.open}}&minus;{{else}}+{{/if}} Passives
          </button>
          <div class="cr-passives__row">
            {{#each scene.passives_gm.rows}}
              <span class="cr-passive cr-passive--gm{{#if this.mark}} cr-passive--{{this.mark}}{{/if}}"
                    data-tooltip="{{this.tip}}">
                {{crIcon this.icon}}<span class="cr-passive__n">{{this.best}}</span>
              </span>
            {{/each}}
          </div>
          {{#if scene.passives_gm.open}}
            <table class="cr-passives__grid">
              {{#each scene.passives_gm.rows}}
                <tr>
                  <th>{{crIcon this.icon}} {{this.label}}</th>
                  {{#each this.all}}
                    <td>{{this.name}} <strong>{{this.score}}</strong></td>
                  {{/each}}
                </tr>
              {{/each}}
            </table>
            <p class="cr-note">
              {{#if scene.passives_gm.fromScene}}Tokens on this scene{{else}}Every character, since this scene has no tokens{{/if}}:
              {{scene.passives_gm.party}}
            </p>
          {{/if}}
        </div>
      {{/if}}

      <div class="cr-scene__passives">
        {{#each scene.passives}}
          {{!-- Static: the best card of this approach in the WHOLE deck plus 2, counting the
                discard. It does not move during play, so it is a constant and not a live stat. --}}
          <span class="cr-passive" data-tooltip="{{this.label}} passive: the best {{this.label}} card in your whole deck, plus 2. It does not change during play.">
            {{crIcon this.icon}}<span class="cr-passive__n">{{this.score}}</span>
          </span>
        {{/each}}
      </div>

      <div class="cr-scene__hand">
        {{#each scene.cards}}
          {{!-- A card whose approach cannot fit the call is dimmed in place, never hidden: the
                same rule a blocked card half follows (hud-spec 3.2), and for the same reason --
                hiding it would hide why it cannot be played. --}}
          <div class="cr-card cr-card--skill{{#if this.wild}} cr-card--wild{{/if}}{{#unless this.answers}} cr-card--mute{{/unless}}"
               {{#if this.art}}style="--cr-art: url('{{this.art}}')"{{/if}}
               role="button" tabindex="0" data-action="check" data-card-id="{{this.id}}"
               data-tooltip="Play it: the check asks how hard, which tool, and whether anybody helped.">
            <div class="cr-card__name">
              {{#if this.icon}}{{crIcon this.icon}}{{/if}}
              {{this.approach}} <strong>{{this.value}}</strong>
            </div>
            <div class="cr-card__front">
              <div class="cr-card__line">{{this.name}}</div>
              {{#if this.edge}}<p class="cr-note">Edge: {{this.edge}}</p>{{/if}}
            </div>
          </div>
        {{/each}}
        {{#unless scene.cards.length}}
          <span class="cr-note">
            {{#if scene.improvising}}
              Nothing left to play. You can still improvise: value 0, with disadvantage.
            {{else}}
              No skill hand dealt. The GM says when a new scene starts.
            {{/if}}
          </span>
        {{/unless}}
      </div>

      <div class="cr-scene__counts">
        {{#if scene.isGM}}
          {{#unless scene.challenge}}
            <button type="button" data-action="startChallenge"
                    data-tooltip="Begin a challenge: a Progress track to fill and a Pressure track to stay under.">Challenge</button>
          {{/unless}}
          {{#if scene.twists.exists}}
            {{!-- The twist deck is drawn by hand, never by a result: skill-rules 4 says the GM can
                  always choose a cost directly, and that a twist which makes no sense goes back. --}}
            <button type="button" data-action="twist"
                    data-tooltip="Draw one twist. {{scene.twists.deck}} left in the deck.">Twist</button>
            <button type="button" data-action="twist" data-two="yes"
                    data-tooltip="Draw two and pick one — for a dramatic failure, or when the first card does not fit the scene.">Twist ×2</button>
          {{/if}}
          {{#if scene.call}}
            <button type="button" data-action="callCheck"
                    data-tooltip="Change the call: a difficulty set wrongly is corrected here, not argued about.">Re-call</button>
          {{/if}}
        {{/if}}
        <button type="button" data-action="dealSkills" {{#if scene.full}}disabled{{/if}}
                data-tooltip="Draw up to your skill hand size. A new scene: a new location, a new conversation, or time passing.">New scene</button>
        <span class="cr-note">Skill deck {{scene.deck}} &middot; discard {{scene.discard}} &mdash;
          the discard comes back on a rest, never on a shuffle.</span>
      </div>
    </section>
  {{/if}}

  {{#if viewer}}
    <section class="cr-hud__spread" data-group-label="{{viewer.label}} — not in play">
      {{#each viewer.cards}}
      <div class="cr-card cr-card--spread{{#if this.harm}} cr-card--harm{{/if}}{{#if this.sole}} cr-card--sole{{/if}}{{#if this.flipped}} cr-card--back{{/if}}{{#if this.passive}} cr-card--passive{{else}} cr-card--takeable{{/if}}"
           data-group="{{this.group}}" data-tooltip="{{this.tip}}"
           {{#if this.art}}style="--cr-art: url('{{this.art}}')"{{/if}}
           {{#unless this.passive}}role="button" tabindex="0" data-action="playSlate" data-slate-id="{{this.id}}"{{/unless}}>
        <div class="cr-card__name">
          {{#if this.icon}}{{crIcon this.icon}}{{/if}}
          {{this.name}}
          {{#if this.flippable}}
            <button type="button" class="cr-card__flip" data-action="flipCard" data-card-id="{{this.id}}"
                    data-tooltip="Turn it over for value, weight and type">&#8634;</button>
          {{/if}}
          {{!-- The one this character reaches for. A toggle, because the second useful gesture
                after "this one from now on" is "actually, ask me" -- and a player holding two
                swords and preferring neither should be asked. --}}
          {{#if this.defaultKind}}
            <button type="button" class="cr-card__default{{#if this.isDefault}} cr-card__default--on{{/if}}"
                    data-action="setDefault" data-slate-id="{{this.id}}"
                    data-tooltip="{{#if this.isDefault}}Your default {{this.defaultKind}}: it goes into the stack by itself. Click to stop.{{else}}Make it your default {{this.defaultKind}}, so staging the action brings it along.{{/if}}">&#9733;</button>
          {{/if}}
        </div>

        {{#if this.flipped}}
          <div class="cr-card__back">
            {{#if this.blurb}}<p class="cr-note">{{this.blurb}}</p>{{/if}}
            <dl class="cr-card__facts">
              {{#each this.facts}}<dt>{{this.label}}</dt><dd>{{this.value}}</dd>{{/each}}
            </dl>
          </div>
        {{else}}
          <div class="cr-card__front">
            {{#each this.lines}}<div class="cr-card__line">{{this}}</div>{{/each}}
            {{#if this.note}}<p class="cr-note">{{this.note}}</p>{{/if}}
          </div>
        {{/if}}
      </div>
      {{else}}
      <div class="cr-card cr-card--spread cr-card--passive">
        <div class="cr-card__front"><span class="cr-note">Nothing left in the deck.</span></div>
      </div>
      {{/each}}
    </section>
  {{/if}}

</div>
