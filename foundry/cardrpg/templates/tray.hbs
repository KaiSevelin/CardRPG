{{!--
  The tray. Always-open, played from directly.

  Card halves show RESOLVED values (item base + card modifier + features), because the rules put
  the verb on the card and the value on the item -- elegant on cardboard, miserable on screen.
--}}
<div class="cr-tray">

  <header class="cr-tray__state">
    <span class="cr-tray__vital" data-tooltip="Health">
      &#9829; {{system.health.value}}/{{system.health.max}}
    </span>
    <span class="cr-tray__vital" data-tooltip="Block{{#if system.blockPersists}} &mdash; holds until your next turn{{/if}}">
      &#9094; {{system.block}}{{#if system.blockPersists}}&infin;{{/if}}
    </span>
    <span class="cr-tray__vital" data-tooltip="Armor, from the equipped body slate">
      &#9636; {{system.armor}}
    </span>
    {{#if system.wounds}}<span class="cr-tray__vital" data-tooltip="Wounds in your deck">&#10006; {{system.wounds}}</span>{{/if}}
    {{#if system.taint.total}}<span class="cr-tray__vital" data-tooltip="Taint in your decks">&#9763; {{system.taint.total}}</span>{{/if}}
    <span class="cr-tray__vital" data-tooltip="Rest tokens">&#9790; {{system.rest.tokens}}</span>

    {{#if exhausted}}
      <span class="cr-tray__flag" data-tooltip="Can't refill to 2 cards: one card per turn, and no reactions">Exhausted</span>
    {{/if}}
    {{#if dazed}}
      <span class="cr-tray__flag" data-tooltip="No secondary this turn">Dazed</span>
    {{/if}}
    {{#if stunned}}
      <span class="cr-tray__flag" data-tooltip="No reactions">Stunned</span>
    {{/if}}
  </header>

  {{#if conditions}}
    <div class="cr-tray__conditions">
      {{#each conditions}}
        <span class="cr-chip" data-tooltip="{{this.label}}{{#if this.creatorId}} &mdash; ticks on its creator's turn{{/if}}">
          {{crIcon this.icon}}{{this.label}}{{#if this.duration}} {{this.duration}}{{/if}}
        </span>
      {{/each}}
    </div>
  {{/if}}

  {{!-- Card halves are meaningless without the item values behind them. --}}
  <div class="cr-tray__equipped">
    {{#each equipped}}
      <span class="cr-chip">{{this.name}}{{#if this.lines}} &middot; {{this.lines}}{{/if}}{{#if this.armor}} &middot; armor {{this.armor}}{{/if}}</span>
    {{else}}
      <span class="cr-note">Nothing equipped &mdash; Strike and Defend need an item.</span>
    {{/each}}
  </div>

  {{!-- The hand. Click a half to stage it; click again to unstage. --}}
  <div class="cr-hand">
    {{#each cards as |card|}}
      <div class="cr-card{{#if card.harm}} cr-card--harm{{/if}}">
        <div class="cr-card__name">{{card.name}}</div>

        {{#if card.harm}}
          <div class="cr-half">
            <span class="cr-note">Can't be played, not even for Brace.</span>
          </div>
        {{else}}
          {{#each card.halves as |half|}}
            <div class="cr-half cr-half--{{half.name}}{{#if half.blocked}} cr-half--blocked{{/if}}{{#if half.staged}} cr-half--staged{{/if}}">
              <span class="cr-half__marker">{{crIcon half.icon}}</span>
              {{#if half.blocked}}
                <span data-tooltip="Blocked right now. The other half may still be playable, and Brace never is.">{{half.text}}</span>
              {{else}}
                <button type="button" class="cr-half__play"
                        data-action="stage" data-card-id="{{card.id}}" data-half="{{half.name}}">
                  {{half.text}}
                </button>
              {{/if}}
            </div>
          {{/each}}
          <div class="cr-half cr-half--reaction">
            <span class="cr-half__marker">{{crIcon ../config.halfIcons.reaction}}</span>
            <span>{{#if card.reaction}}{{card.reaction}}{{else}}Brace{{/if}}</span>
          </div>
        {{/if}}
      </div>
    {{else}}
      <p class="cr-note">Hand is empty. Refill at the start of the round, or Catch Breath.</p>
    {{/each}}
  </div>

  {{!-- Staging order is play order, which is how "either order" gets expressed. --}}
  <div class="cr-tray__staged">
    {{#if staged}}
      <span class="cr-note">Playing in this order:</span>
      {{#each staged}}
        <span class="cr-chip cr-chip--staged">{{@index}}. {{this.name}} ({{this.half}})</span>
      {{/each}}
    {{else}}
      <span class="cr-note">Click a primary and a secondary, from two different cards.</span>
    {{/if}}

    {{#if targets}}
      <span class="cr-chip" data-tooltip="Fate is drawn once per action, not per target">
        Target: {{#each targets}}{{this}}{{#unless @last}}, {{/unless}}{{/each}}
      </span>
    {{/if}}

    <span class="cr-tray__buttons">
      <button type="button" data-action="play" {{#unless canPlay}}disabled{{/unless}}>Play</button>
      <button type="button" data-action="clear" {{#unless canPlay}}disabled{{/unless}}>Clear</button>
      <button type="button" data-action="breathe"
              data-tooltip="Your whole turn. Recovers half the discard pile at random; one of the rest is Spent.">
        Catch Breath
      </button>
      <button type="button" data-action="refill" data-tooltip="Draw back up to hand size">Refill</button>
    </span>
  </div>

  {{!-- The draw pile is the tension meter, so it is a bar. --}}
  <footer class="cr-tray__meters">
    <span class="cr-meter">
      <span>Draw {{counts.draw}}</span>
      <span class="cr-meter__bar"><span class="cr-meter__fill" style="width: {{drawPct}}%"></span></span>
    </span>
    <span class="cr-note">discard {{counts.discard}} &middot; spent {{counts.spent}}</span>
    <span class="cr-note" data-tooltip="Miss and Critical both reshuffle, so the deck always holds one of each between reshuffles">
      fate {{counts.fate}}/20{{#if fateSwing}} &middot; swing {{fateSwing}}%{{/if}}
    </span>
  </footer>

</div>
